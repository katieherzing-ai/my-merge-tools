}

// ═══════════════════════════════════════════
//  Navigation
// ═══════════════════════════════════════════
function canAdvance() {
  if (currentStep === 0) {
    const missingRequired = REQUIRED_COLS.filter(c => !csvHeaders.includes(c));
    return donors.length > 0 && missingRequired.length === 0;
  }
  if (currentStep === 1) {
    return document.getElementById("letter-body").value.trim() &&
           document.getElementById("letter-closing").value.trim() &&
           document.getElementById("pastor-name").value.trim();
  }
  return true;
}

function navigate(dir) {
  if (dir === 1 && !canAdvance()) return;
  const next = currentStep + dir;
  if (next < 0 || next >= TOTAL_STEPS) return;

  if (next === 2) {
    const sel = document.getElementById("donor-select");
    sel.innerHTML = donors.map((d, i) => {
      const name = (d[COL.mailingName] || "Donor " + (i+1));
      return `<option value="${i}">${esc(name)}</option>`;
    }).join("");
    updatePreview();
    document.getElementById("print-all-btn").textContent = "🖨 Print All " + donors.length + " Letters";
  }

  // Transition
  document.getElementById("step-" + currentStep).classList.remove("active");
  const oldTab = document.getElementById("tab-" + currentStep);
  oldTab.classList.remove("active");
  if (dir === 1) oldTab.classList.add("done");

  currentStep = next;
  document.getElementById("step-" + currentStep).classList.add("active");
  const newTab = document.getElementById("tab-" + currentStep);
  newTab.classList.remove("done");
  newTab.classList.add("active");

  updateNavButtons();
}

function updateNavButtons() {
  const back = document.getElementById("btn-back");
  const next = document.getElementById("btn-next");
  back.style.visibility = currentStep > 0 ? "visible" : "hidden";
  if (currentStep === TOTAL_STEPS - 1) {
    next.style.display = "none";
  } else {
    next.style.display = "inline-block";
    next.textContent = "Continue →";
    next.disabled = !canAdvance();
  }
  // Sync tabs
  for (let i = 0; i < TOTAL_STEPS; i++) {
    const t = document.getElementById("tab-" + i);
    t.classList.remove("active","done");
    if (i === currentStep) t.classList.add("active");
    else if (i < currentStep) t.classList.add("done");
  }
}

function updateCount(textareaId, spanId) {
  const len = document.getElementById(textareaId).value.length;
  const span = document.getElementById(spanId);
  span.textContent = len;
  // thresholds
  const limits = { "letter-body": 600, "letter-closing": 350 };
  span.className = (limits[textareaId] && len > limits[textareaId]) ? "over" : "";
}

// Tab click — backward only
for (let i = 0; i < TOTAL_STEPS; i++) {
  (function(idx){
    document.getElementById("tab-" + idx).addEventListener("click", function() {
      if (idx >= currentStep) return;
      document.getElementById("step-" + currentStep).classList.remove("active");
      document.getElementById("tab-" + currentStep).classList.remove("active");
      document.getElementById("tab-" + currentStep).classList.add("done");
      currentStep = idx;
      document.getElementById("step-" + currentStep).classList.add("active");
      document.getElementById("tab-" + currentStep).classList.remove("done");
      document.getElementById("tab-" + currentStep).classList.add("active");
      updateNavButtons();
    });
  })(i);
}

// Live revalidation
["letter-body","letter-closing","pastor-name"].forEach(id => {
  document.getElementById(id).addEventListener("input", updateNavButtons);
});
// char counters
[["letter-body","count-body"],["letter-closing","count-closing"]].forEach(([tid,sid]) => {
  document.getElementById(tid).addEventListener("input", () => updateCount(tid, sid));
});

// ═══════════════════════════════════════════
//  Utilities
// ═══════════════════════════════════════════
function esc(s) {
  return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function escHtml(s) {
  return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

updateNavButtons();
</script>
